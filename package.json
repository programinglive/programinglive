{
  "name": "programinglive",
  "private": true,
  "version": "0.1.11",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "test": "node --test",
    "bulletin:discord": "node scripts/post-development-bulletin.cjs",
    "prepare": "husky",
    "release": "node scripts/release.cjs",
    "release:major": "node scripts/release.cjs major",
    "release:minor": "node scripts/release.cjs minor",
    "release:patch": "node scripts/release.cjs patch",
    "release:first": "node scripts/release.cjs --first-release"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@netlify/plugin-nextjs": "^5.16.2",
    "@programinglive/commiter": "^1.2.17",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^18.2.70",
    "@types/react-dom": "^18.2.22",
    "autoprefixer": "^10.4.20",
    "husky": "^9.1.7",
    "postcss": "^8.4.49",
    "standard-version": "^9.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  },
  "standard-version": {
    "releaseCommitMessageFormat": "chore(release): {{currentTag}} 🚀",
    "types": [
      {
        "type": "feat",
        "section": "✨ Features"
      },
      {
        "type": "fix",
        "section": "🐛 Bug Fixes"
      },
      {
        "type": "perf",
        "section": "⚡ Performance"
      },
      {
        "type": "refactor",
        "section": "♻️ Refactors"
      },
      {
        "type": "docs",
        "section": "📝 Documentation"
      },
      {
        "type": "style",
        "section": "💄 Styles"
      },
      {
        "type": "test",
        "section": "✅ Tests"
      },
      {
        "type": "build",
        "section": "🏗️ Build System"
      },
      {
        "type": "ci",
        "section": "👷 Continuous Integration"
      },
      {
        "type": "chore",
        "section": "🧹 Chores"
      },
      {
        "type": "revert",
        "section": "⏪ Reverts"
      }
    ]
  },
  "overrides": {
    "qs": "^6.14.1",
    "glob": "^10.5.0",
    "jws": "^3.2.3",
    "@rollup/rollup-android-arm-eabi": "npm:@rollup/rollup-win32-x64-msvc",
    "@rollup/rollup-android-arm64": "npm:@rollup/rollup-win32-x64-msvc",
    "@rollup/rollup-darwin-arm64": "npm:@rollup/rollup-win32-x64-msvc",
    "@rollup/rollup-darwin-x64": "npm:@rollup/rollup-win32-x64-msvc",
    "@rollup/rollup-linux-arm-gnueabihf": "npm:@rollup/rollup-win32-x64-msvc",
    "@rollup/rollup-linux-arm64-gnu": "npm:@rollup/rollup-win32-x64-msvc",
    "@rollup/rollup-linux-arm64-musl": "npm:@rollup/rollup-win32-x64-msvc",
    "@rollup/rollup-linux-riscv64-gnu": "npm:@rollup/rollup-win32-x64-msvc",
    "@rollup/rollup-linux-s390x-gnu": "npm:@rollup/rollup-win32-x64-msvc",
    "@rollup/rollup-linux-x64-gnu": "npm:@rollup/rollup-win32-x64-msvc",
    "@rollup/rollup-linux-x64-musl": "npm:@rollup/rollup-win32-x64-msvc"
  },
  "dependencies": {
    "next": "^16.3.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
